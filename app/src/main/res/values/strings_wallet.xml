<?xml version="1.0" encoding="utf-8"?>
<!--
  User-facing text for the wallet's own screens.

  Deliberately separate from values/strings.xml, which is 365 lines of bread-wallet legacy that
  nothing in this app references. Mixing new keys into it would make the dead half impossible to
  identify later.

  TRANSLATION NOTE. The warning strings here are not ordinary UI text — they are the difference
  between someone keeping their money and losing it. A machine pass is fine for buttons and
  headings; anything marked WARNING below needs a native speaker's eye before it ships, because a
  softened "cannot be recovered" or a vague "anyone with these words" costs somebody their coins.

  Brand names (DigiByte, DGB) are NOT translated.
-->
<resources>

    <!-- ── Onboarding: first screen ─────────────────────────────────────────────── -->
    <string name="onb_title">Secure your DGB</string>
    <string name="onb_tagline">Your keys, your coins. No third parties.</string>
    <string name="onb_seed_length">Seed phrase length</string>
    <string name="onb_words_count">%1$d words</string>
    <string name="onb_create">Create New Wallet</string>
    <string name="onb_recover">Recover Existing Wallet</string>
    <string name="onb_footer">DigiByte — Secure, Fast, Decentralized</string>
    <string name="app_name_display">DigiByte Wallet</string>

    <!-- ── Seed display ─────────────────────────────────────────────────────────── -->
    <!-- WARNING: "cannot be recovered" is the whole point. Do not soften it. -->
    <string name="seed_screenshot_blocked">Screenshots are blocked. Write these words down — they cannot be recovered.</string>
    <string name="seed_title">Your Recovery Phrase</string>
    <string name="seed_word_count">%1$d-word seed phrase</string>
    <!-- WARNING: the three tips below are the only thing standing between a user and a
         drained wallet. Translate for clarity over elegance. -->
    <string name="seed_never_share">Never share your seed phrase</string>
    <string name="seed_tip_paper">Write it on paper — not digitally</string>
    <string name="seed_tip_safe">Store it somewhere safe and private</string>
    <string name="seed_tip_anyone">Anyone with these words can take your DGB</string>
    <string name="seed_written_down">I have written these down</string>

    <!-- ── Seed verification ────────────────────────────────────────────────────── -->
    <string name="verify_progress">Verification %1$d of %2$d</string>
    <string name="verify_question">What is word #%1$d?</string>

    <!-- ── PIN setup ────────────────────────────────────────────────────────────── -->
    <string name="pin_biometric_prompt_title">Enable Biometric Unlock</string>
    <string name="pin_biometric_prompt_subtitle">Authenticate to enable fingerprint/face unlock</string>
    <string name="pin_biometric_ask">Enable Biometric Unlock?</string>
    <string name="pin_biometric_body">Use your fingerprint or face to unlock the wallet quickly. You can always use your PIN instead.</string>
    <string name="pin_biometric_enable">Enable Biometrics</string>
    <string name="pin_biometric_skip">Skip for now</string>
    <string name="pin_backspace">Backspace</string>

    <!-- ── Unlock ───────────────────────────────────────────────────────────────── -->
    <string name="unlock_title">Enter PIN</string>
    <string name="unlock_subtitle">Enter your 6-digit PIN to unlock</string>
    <string name="unlock_locked">Locked — try again in %1$s</string>
    <string name="unlock_unlocking">Unlocking…</string>
    <string name="unlock_biometrics_cd">Unlock with biometrics</string>

    <!-- ── Recover ──────────────────────────────────────────────────────────────── -->
    <string name="recover_title">Recover Wallet</string>
    <string name="recover_body">Enter your seed phrase to restore your wallet.</string>
    <string name="recover_continue">Continue</string>

    <!-- ── Seed display / verification ──────────────────────────────────────────── -->
    <string name="seed_retry">Retry</string>
    <string name="verify_next">Next</string>
    <string name="verify_finish">Finish</string>
    <string name="verify_success_title">Verified!</string>
    <string name="verify_retry_title">Let\'s try again</string>
    <string name="verify_success_body">Your seed phrase is safely written down. Now let\'s set up a PIN.</string>
    <string name="verify_retry_body">Some answers were incorrect. Please review your seed phrase and try again.</string>
    <string name="verify_setup_pin">Set Up PIN</string>
    <string name="verify_try_again">Try Again</string>

    <!-- ── PIN entry / confirmation ─────────────────────────────────────────────── -->
    <string name="pin_set_title">Set Your PIN</string>
    <string name="pin_confirm_title">Confirm Your PIN</string>
    <string name="pin_set_body">Choose a 6-digit PIN to protect your wallet</string>
    <string name="pin_confirm_body">Enter your PIN again to confirm</string>
    <string name="pin_err_mismatch">PINs do not match. Please try again.</string>
    <string name="pin_err_save">Failed to save PIN. Please try again.</string>
    <string name="pin_err_wallet">Wallet creation failed. Please try again.</string>

    <!-- ── Unlock failures ──────────────────────────────────────────────────────── -->
    <string name="unlock_err_failed">Unlock failed. Please try again.</string>
    <!-- WARNING: this is the last thing shown before the wallet is erased. -->
    <string name="unlock_wiping">Too many failed attempts — wiping wallet</string>
    <!-- Deliberately NOT a plural. The English original read "N attempts before lockout", which
         needs a plural table per language and gets the count noun wrong in the many languages
         whose rules differ from English. A trailing count is grammatical in all twelve. -->
    <string name="unlock_attempts_left">Incorrect PIN. Attempts remaining: %1$d</string>

    <!-- ── Background-sync / battery prompt (shown after onboarding) ─────────────── -->
    <string name="battery_title">Keep sync running in the background</string>
    <string name="battery_body">Android can put this wallet to sleep when the screen is off, which drops its connection to the DigiByte network and can leave it stuck at 0 peers until you reopen it.\n\nAllow it to run unrestricted so it keeps syncing.</string>
    <!-- Appended to battery_body on Samsung devices only. Device Care, Battery and the quoted
         setting name are Samsung\'s own UI labels — match the wording Samsung ships in that
         language, or the user cannot find the screen being described. -->
    <string name="battery_body_samsung">\n\nOn Samsung, also open Device Care → Battery → \"Never sleeping apps\" and add DigiByte Wallet.</string>
    <string name="battery_open_settings">Open settings</string>

    <!-- ── Tor prompt ───────────────────────────────────────────────────────────── -->
    <string name="tor_title">New Privacy Feature</string>
    <string name="tor_body">Tor routing is now available. When enabled, your wallet connects to the DigiByte network through Tor, hiding your IP address from peers.\n\nEnable Tor routing?</string>
    <string name="tor_enable">Enable</string>

    <string name="common_not_now">Not now</string>

</resources>
