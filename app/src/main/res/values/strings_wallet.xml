<?xml version="1.0" encoding="utf-8"?>
<!--
  User-facing text for the wallet's own screens.

  Deliberately separate from values/strings.xml, which is 365 lines of bread-wallet legacy that
  nothing in this app references. Mixing new keys into it would make the dead half impossible to
  identify later.

  TRANSLATION NOTE. The warning strings here are not ordinary UI text — they are the difference
  between someone keeping their money and losing it. A machine pass is fine for buttons and
  headings; anything marked WARNING below needs a native speaker's eye before it ships, because a
  softened "cannot be recovered" or a vague "anyone with these words" costs somebody their coins.

  Brand names (DigiByte, DGB) are NOT translated.
-->
<resources>

    <!-- ── Onboarding: first screen ─────────────────────────────────────────────── -->
    <string name="onb_title">Secure your DGB</string>
    <string name="onb_tagline">Your keys, your coins. No third parties.</string>
    <string name="onb_seed_length">Seed phrase length</string>
    <string name="onb_words_count">%1$d words</string>
    <string name="onb_create">Create New Wallet</string>
    <string name="onb_recover">Recover Existing Wallet</string>
    <string name="onb_footer">DigiByte — Secure, Fast, Decentralized</string>
    <string name="app_name_display">DigiByte Wallet</string>

    <!-- ── Seed display ─────────────────────────────────────────────────────────── -->
    <!-- WARNING: "cannot be recovered" is the whole point. Do not soften it. -->
    <string name="seed_screenshot_blocked">Screenshots are blocked. Write these words down — they cannot be recovered.</string>
    <string name="seed_title">Your Recovery Phrase</string>
    <string name="seed_word_count">%1$d-word seed phrase</string>
    <!-- WARNING: the three tips below are the only thing standing between a user and a
         drained wallet. Translate for clarity over elegance. -->
    <string name="seed_never_share">Never share your seed phrase</string>
    <string name="seed_tip_paper">Write it on paper — not digitally</string>
    <string name="seed_tip_safe">Store it somewhere safe and private</string>
    <string name="seed_tip_anyone">Anyone with these words can take your DGB</string>
    <string name="seed_written_down">I have written these down</string>

