    <string name="rf_err_network">Hindi maabot ang lookup service. Suriin ang iyong koneksyon sa internet at subukan ulit.</string>
    <string name="rf_err_timeout">Nag-timeout ang request. Subukan ulit kapag mas malakas ang koneksyon.</string>
    <string name="rf_err_seed">Hindi na-load ang seed ng wallet. I-unlock ang wallet mo at subukan ulit.</string>
    <string name="rf_err_lookup">Hindi maabot ang lookup service. Subukan ulit mamaya.</string>
