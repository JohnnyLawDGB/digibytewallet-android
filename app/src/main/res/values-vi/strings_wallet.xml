    <string name="ab_type_value">HD Wallet (BIP84)</string>
    <string name="ab_type_desc">Ví Hierarchical Deterministic được tạo từ cụm từ gốc. Có thể tạo nhiều địa chỉ từ một bản sao lưu — như có vô số số tài khoản từ một khóa chính.</string>
    <string name="ab_path_desc">Đường dẫn dẫn xuất dùng để tạo địa chỉ của bạn. 84 = chuẩn BIP84, 20 = loại tiền DigiByte (SLIP44), 0 = tài khoản đầu tiên. Điều này đảm bảo mọi ví tương thích BIP84 đều khôi phục được địa chỉ của bạn từ cùng cụm từ gốc. Tương thích với công cụ BIP39 của Ian Coleman.</string>
    <string name="ab_format_value">SegWit (Bech32)</string>
    <string name="ab_format_desc">Dùng địa chỉ SegWit hiện đại bắt đầu bằng dgb1. Chúng hiệu quả hơn và phí thấp hơn địa chỉ Legacy cũ bắt đầu bằng D.</string>
    <string name="ab_network_value">Mainnet</string>
    <string name="ab_network_desc">Mainnet là mạng DigiByte thật, nơi DGB có giá trị thực. Testnet dành cho nhà phát triển thử nghiệm mà không dùng tiền thật.</string>
    <string name="ab_security_value">Tự quản lý</string>
    <string name="ab_security_desc">Khóa của bạn không bao giờ rời khỏi thiết bị này. Không công ty hay máy chủ nào giữ tiền của bạn — chỉ bạn kiểm soát ví của mình. Nếu mất cụm từ gốc, không ai có thể khôi phục hộ bạn.</string>
    <string name="ab_sync_value">SPV (Compact Filters)</string>
    <string name="ab_sync_desc">Simplified Payment Verification — đồng bộ trực tiếp với mạng P2P DigiByte mà không cần tải toàn bộ blockchain. Dùng compact block filters BIP157/158: ví tải bộ lọc về và kiểm tra ngay trên máy, nên các địa chỉ bạn sở hữu không bao giờ rời khỏi điện thoại.</string>
    <string name="ab_security_build">AES-256-GCM seed encryption, hardware-backed Keystore</string>
    <string name="ab_core_value">9.26 (SPV node)</string>
    <string name="ab_mit">Phần mềm này được cung cấp theo Giấy phép MIT.</string>
    <string name="ab_tagline">DigiByte là một blockchain phi tập trung và một loại tiền kỹ thuật số.</string>

