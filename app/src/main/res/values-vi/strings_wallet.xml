    <string name="pass_advanced">Nâng cao — thêm cụm mật khẩu</string>
    <string name="pass_optional">Tùy chọn</string>
    <string name="pass_what">Cụm mật khẩu là một từ hoặc câu bổ sung do bạn chọn. Khi có nó, chỉ riêng cụm từ khôi phục không còn đủ để mở ví này — người nhặt được các từ bạn ghi ra cũng không tiêu được tiền của bạn.</string>
    <string name="pass_warn">Hãy ghi lại cụm mật khẩu, nhưng cất giữ TÁCH RIÊNG khỏi cụm từ khôi phục của bạn — để chung một chỗ, cả hai lại trở thành một bí mật duy nhất và cụm mật khẩu không còn bảo vệ được gì. Nếu bạn làm mất nó, chỉ riêng những từ này sẽ KHÔNG khôi phục được ví của bạn, và không ai có thể khôi phục hộ bạn.</string>
    <string name="pass_scope">Điều này bảo vệ bản sao lưu bạn ghi ra giấy. Trên điện thoại này, mã PIN vẫn là thứ khóa ví.</string>
